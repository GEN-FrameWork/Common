if(GRP_FEATURE)

  list(APPEND GEN_SOURCES_MODULES_LIST "${GEN_DIRECTORY_SOURCES_PLATFORMS_LINUX}/GRPLINUXFactory.cpp")
  list(APPEND GEN_SOURCES_MODULES_LIST "${GEN_DIRECTORY_SOURCES_PLATFORMS_LINUX}/GRPLINUXScreenX11.cpp")
  list(APPEND GEN_SOURCES_MODULES_LIST "${GEN_DIRECTORY_SOURCES_PLATFORMS_LINUX}/GRPLINUXScreenFrameBuffer.cpp")

  # Same pattern as GRPLINUXScreenX11.cpp above: the module is always added to the build,
  # and is itself wrapped end-to-end in "#ifdef LINUX_WAYLAND_ACTIVE" (see
  # GRPLINUXScreenWayland.h/.cpp), so it compiles down to an empty translation unit -- and
  # needs none of the generated protocol headers -- on any build where Wayland is not active.
  list(APPEND GEN_SOURCES_MODULES_LIST "${GEN_DIRECTORY_SOURCES_PLATFORMS_LINUX}/GRPLINUXScreenWayland.cpp")

  if(GEN_LINUX_WAYLAND_ACTIVE)

    list(APPEND GEN_SOURCES_MODULES_LIST ${GEN_WAYLAND_PROTOCOL_SOURCES})

  endif()


