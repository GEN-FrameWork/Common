    list(APPEND GEN_SOURCES_MODULES_LIST "${GEN_DIRECTORY_SOURCES_PLATFORMS_LINUX}/GRPLINUXDesktopManager.cpp")

  endif()

  if(GRP_OPENGL_FEATURE AND LINUX_X11_FEATURE)

    list(APPEND GEN_SOURCES_MODULES_LIST "${GEN_DIRECTORY_SOURCES_PLATFORMS_LINUX}/GRPLINUXBlitGLESX11.cpp")

  endif()

  if(GRP_OPENGL_FEATURE AND GEN_LINUX_WAYLAND_ACTIVE)

    list(APPEND GEN_SOURCES_MODULES_LIST "${GEN_DIRECTORY_SOURCES_PLATFORMS_LINUX}/GRPLINUXBlitGLESWayland.cpp")

  endif()

endif()


